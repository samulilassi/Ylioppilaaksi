      "ratkaisu": [
        "A = ∫<sub>0</sub><sup>3</sup> x<sup>2</sup> dx = [x<sup>3</sup>/3]<sub>0</sub><sup>3</sup> = <b>9</b>."
      ]
    },
    {
      "id": "maa7-harj-07",
      "numero": "7",
      "aihe": "Kahden käyrän välinen ala",
      "pisteet": 6,
      "muistilista": "MAA7",
      "teksti": [
        "<b>Laske</b> käyrien y = x ja y = x<sup>2</sup> rajaaman alueen pinta-ala."
