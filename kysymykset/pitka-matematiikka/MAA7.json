      "vastaus": {
        "tyyppi": "numero",
        "oikea": 1,
        "toleranssi": 0.01,
        "esimerkki": "2"
      },
      "ratkaisu": [
        "Integraalifunktio ln x.",
        "ln e − ln 1 = 1 − 0 = <b>1</b>."
      ]
    },
    {
      "id": "maa7-harj-06",
      "numero": "6",
      "aihe": "Pinta-ala",
      "pisteet": 6,
      "muistilista": "MAA7",
      "teksti": [
        "<b>Laske</b> käyrän y = x<sup>2</sup>, x-akselin ja suoran x = 3 rajaaman alueen pinta-ala."
