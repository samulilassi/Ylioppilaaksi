      "ratkaisu": [
        "Nollakohdat x = ±3.",
        "A = ∫<sub>−3</sub><sup>3</sup> (9 − x<sup>2</sup>) dx = [9x − x<sup>3</sup>/3]<sub>−3</sub><sup>3</sup> = 18 − (−18) = <b>36</b>."
      ]
    },
    {
      "id": "maa7-harj-09",
      "numero": "9",
      "aihe": "Integraalifunktio alkuehdolla",
      "pisteet": 6,
      "muistilista": "MAA7",
      "teksti": [
        "Funktion F derivaatta on F'(x) = 2x ja F(1) = 5. <b>Laske F(3).</b>"
