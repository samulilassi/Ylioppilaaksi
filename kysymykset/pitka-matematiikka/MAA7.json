  "kysymykset": [
    {
      "id": "maa-harj-integraali-1",
      "numero": "1",
      "aihe": "Integraali · Määrätty integraali",
      "pisteet": 12,
      "muistilista": "MAA7",
      "teksti": [
        "<b>Laske määrätty integraali</b> ∫<sub>0</sub><sup>2</sup> (3x<sup>2</sup> + 2x) dx."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 12,
        "toleranssi": 0.001,
        "esimerkki": "8"
      },
      "ratkaisu": [
        "Integraalifunktio: F(x) = x<sup>3</sup> + x<sup>2</sup>.",
        "F(2) − F(0) = (8 + 4) − 0 = <b>12</b>."
      ]
    },
    {
      "id": "maa7-harj-02",
      "numero": "2",
      "aihe": "Määrätty integraali",
      "pisteet": 6,
      "muistilista": "MAA7",
      "teksti": [
        "<b>Laske</b> ∫<sub>1</sub><sup>2</sup> 4x<sup>3</sup> dx."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 15,
        "toleranssi": 0.01,
        "esimerkki": "16"
      },
      "ratkaisu": [
        "Integraalifunktio x<sup>4</sup>.",
        "2<sup>4</sup> − 1<sup>4</sup> = 16 − 1 = <b>15</b>."
      ]
    },
    {
      "id": "maa7-harj-03",
      "numero": "3",
      "aihe": "Sinin integraali",
      "pisteet": 6,
      "muistilista": "MAA7",
      "teksti": [
        "<b>Laske</b> ∫<sub>0</sub><sup>π</sup> sin x dx."
