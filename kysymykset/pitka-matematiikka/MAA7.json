      "vastaus": {
        "tyyppi": "numero",
        "oikea": 2,
        "toleranssi": 0.01,
        "esimerkki": "1"
      },
      "ratkaisu": [
        "Integraalifunktio −cos x.",
        "−cos π − (−cos 0) = 1 + 1 = <b>2</b>."
      ]
    },
    {
      "id": "maa7-harj-04",
      "numero": "4",
      "aihe": "Eksponenttifunktion integraali",
      "pisteet": 6,
      "muistilista": "MAA7",
      "teksti": [
        "<b>Laske</b> ∫<sub>0</sub><sup>1</sup> e<sup>x</sup> dx (kahden desimaalin tarkkuudella)."
