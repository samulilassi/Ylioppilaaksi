      "ratkaisu": [
        "F(x) = x<sup>2</sup> + C. F(1) = 1 + C = 5 ⇒ C = 4.",
        "F(3) = 9 + 4 = <b>13</b>."
      ]
    },
    {
      "id": "maa7-harj-10",
      "numero": "10",
