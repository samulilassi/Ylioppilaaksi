      "vastaus": {
        "tyyppi": "numero",
        "oikea": 1.718282,
        "toleranssi": 0.01,
        "desimaalit": 2,
        "esimerkki": "2,00"
      },
      "ratkaisu": [
        "Integraalifunktio e<sup>x</sup>.",
        "e − 1 ≈ <b>1,72</b>."
      ]
    },
    {
      "id": "maa7-harj-05",
      "numero": "5",
      "aihe": "1/x:n integraali",
      "pisteet": 6,
      "muistilista": "MAA7",
      "teksti": [
        "<b>Laske</b> ∫<sub>1</sub><sup>e</sup> (1/x) dx."
