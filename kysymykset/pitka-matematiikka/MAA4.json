    },
    {
      "id": "maa4-harj-13",
      "numero": "13",
      "aihe": "Yhdensuuntaiset vektorit",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "Millä t:n arvolla vektorit 2<b>i</b> + t<b>j</b> ja 3<b>i</b> + 6<b>j</b> ovat <b>yhdensuuntaiset</b>?"
