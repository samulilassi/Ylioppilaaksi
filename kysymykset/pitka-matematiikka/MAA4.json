      ]
    },
    {
      "id": "maa4-harj-11",
      "numero": "11",
      "aihe": "Vektorilaskenta",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "Olkoon <b>a</b> = 2<b>i</b> + 3<b>j</b> ja <b>b</b> = <b>i</b> − <b>j</b>. <b>Laske |2a − b|.</b>"
