  "kysymykset": [
    {
      "id": "maa4-harj-01",
      "numero": "1",
      "aihe": "Pisteiden etäisyys",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Laske</b> pisteiden (1, 2) ja (4, 6) välinen etäisyys."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 5,
        "toleranssi": 0.01,
        "esimerkki": "3"
      },
      "ratkaisu": [
        "d = √((4 − 1)<sup>2</sup> + (6 − 2)<sup>2</sup>) = √(9 + 16) = <b>5</b>."
      ]
    },
    {
      "id": "maa4-harj-02",
      "numero": "2",
      "aihe": "Janan keskipiste",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Määritä</b> pisteiden (−2, 5) ja (6, −1) välisen janan keskipiste.",
        "Anna vastaus muodossa x; y."
      ],
      "vastaus": {
        "tyyppi": "numerot",
        "oikeat": [
          2,
          2
        ],
        "toleranssi": 0.01,
        "jarjestys": true,
        "esimerkki": "1; 3"
      },
      "ratkaisu": [
        "x = (−2 + 6) / 2 = 2, y = (5 + (−1)) / 2 = 2.",
        "Keskipiste on <b>(2, 2)</b>."
      ]
    },
    {
      "id": "maa4-harj-03",
      "numero": "3",
      "aihe": "Suoran kulmakerroin",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Laske</b> pisteiden (1, 3) ja (5, 11) kautta kulkevan suoran kulmakerroin."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 2,
        "toleranssi": 0.01,
        "esimerkki": "3"
      },
      "ratkaisu": [
        "k = Δy / Δx = (11 − 3) / (5 − 1) = 8 / 4 = <b>2</b>."
      ]
    },
    {
      "id": "maa4-harj-04",
      "numero": "4",
      "aihe": "Suorien leikkauspiste",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Määritä</b> suorien y = 2x + 1 ja y = −x + 7 leikkauspiste.",
        "Anna vastaus muodossa x; y."
      ],
      "vastaus": {
        "tyyppi": "numerot",
        "oikeat": [
          2,
          5
        ],
        "toleranssi": 0.01,
        "jarjestys": true,
        "esimerkki": "1; 3"
      },
      "ratkaisu": [
        "2x + 1 = −x + 7 ⇒ 3x = 6 ⇒ x = 2.",
        "y = 2·2 + 1 = 5. Leikkauspiste on <b>(2, 5)</b>."
      ]
    },
    {
      "id": "maa4-harj-05",
      "numero": "5",
      "aihe": "Kohtisuora suora",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "Mikä on suoraa 3x − 4y + 1 = 0 vastaan <b>kohtisuoran</b> suoran kulmakerroin?"
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": -1.333333,
        "toleranssi": 0.01,
        "desimaalit": 2,
        "esimerkki": "0,5"
      },
      "ratkaisu": [
        "Ratkaistaan y: y = ¾x + ¼, joten k₁ = ¾.",
        "Kohtisuoralle k₁k₂ = −1 ⇒ k₂ = −4/3 ≈ <b>−1,33</b>."
      ]
    },
    {
      "id": "maa4-harj-06",
      "numero": "6",
      "aihe": "Ympyrän yhtälö",
      "pisteet": 12,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Määritä</b> ympyrän x<sup>2</sup> + y<sup>2</sup> − 6x + 4y − 12 = 0 säde."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 5,
        "toleranssi": 0.01,
        "esimerkki": "3"
      },
      "ratkaisu": [
        "Täydennetään neliöiksi: (x − 3)<sup>2</sup> + (y + 2)<sup>2</sup> = 12 + 9 + 4 = 25.",
        "Säde r = <b>5</b> (keskipiste (3, −2))."
      ]
    },
    {
      "id": "maa4-harj-07",
      "numero": "7",
      "aihe": "Pisteen etäisyys suorasta",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Laske</b> pisteen (3, 4) etäisyys suorasta 3x + 4y − 5 = 0."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 4,
        "toleranssi": 0.01,
        "esimerkki": "2"
      },
      "ratkaisu": [
        "d = |ax₀ + by₀ + c| / √(a² + b²).",
        "d = |9 + 16 − 5| / 5 = 20 / 5 = <b>4</b>."
      ]
    },
    {
      "id": "maa4-harj-08",
      "numero": "8",
      "aihe": "Vektorin pituus",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Laske</b> vektorin <b>a</b> = 3<b>i</b> − 4<b>j</b> pituus."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 5,
        "toleranssi": 0.01,
        "esimerkki": "7"
      },
      "ratkaisu": [
        "|a| = √(3<sup>2</sup> + (−4)<sup>2</sup>) = √25 = <b>5</b>."
      ]
    },
    {
      "id": "maa4-harj-09",
      "numero": "9",
      "aihe": "Pistetulo",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Laske</b> vektorien <b>a</b> = 2<b>i</b> − <b>j</b> ja <b>b</b> = 3<b>i</b> + 4<b>j</b> pistetulo."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 2,
        "toleranssi": 0.01,
        "esimerkki": "10"
      },
      "ratkaisu": [
        "a · b = 2·3 + (−1)·4 = 6 − 4 = <b>2</b>."
      ]
    },
    {
      "id": "maa4-harj-10",
      "numero": "10",
      "aihe": "Vektorien välinen kulma",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Laske</b> vektorien <b>i</b> ja <b>i</b> + <b>j</b> välinen kulma."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 45,
        "toleranssi": 0.1,
        "yksikko": "°",
        "esimerkki": "30"
      },
      "ratkaisu": [
        "cos α = (a · b) / (|a||b|) = 1 / (1 · √2).",
