        "esimerkki": "5,00"
      },
      "ratkaisu": [
        "2a − b = (4 − 1)i + (6 + 1)j = 3i + 7j.",
        "|2a − b| = √(9 + 49) = √58 ≈ <b>7,62</b>."
      ]
    },
    {
      "id": "maa4-harj-12",
      "numero": "12",
      "aihe": "Paraabeli",
      "pisteet": 6,
      "muistilista": "MAA4",
      "teksti": [
        "<b>Määritä</b> paraabelin y = x<sup>2</sup> − 4x + 1 huipun y-koordinaatti."
