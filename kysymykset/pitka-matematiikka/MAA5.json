      "ratkaisu": [
        "a<sub>n</sub> = a<sub>1</sub> + (n − 1)d.",
        "a<sub>20</sub> = 3 + 19 · 4 = <b>79</b>."
      ]
    },
    {
      "id": "maa5-harj-12",
      "numero": "12",
      "aihe": "Aritmeettinen summa",
      "pisteet": 6,
      "muistilista": "MAA5",
      "teksti": [
        "<b>Laske summa</b> 1 + 2 + 3 + … + 100."
