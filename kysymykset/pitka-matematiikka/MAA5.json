    {
      "id": "maa5-harj-11",
      "numero": "11",
      "aihe": "Aritmeettinen jono",
      "pisteet": 6,
      "muistilista": "MAA5",
      "teksti": [
        "Aritmeettisen jonon ensimmäinen jäsen on 3 ja erotus 4. <b>Mikä on jonon 20. jäsen?</b>"
