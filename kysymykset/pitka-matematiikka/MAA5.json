        "tyyppi": "numero",
        "oikea": 5050,
        "toleranssi": 0.01,
        "esimerkki": "5 000"
      },
      "ratkaisu": [
        "S = n(a<sub>1</sub> + a<sub>n</sub>) / 2 = 100 · 101 / 2 = <b>5 050</b>."
      ]
    },
