        "tyyppi": "numero",
        "oikea": 728,
        "toleranssi": 0.01,
        "esimerkki": "700"
      },
      "ratkaisu": [
        "Jäseniä on 6 (2 · 3<sup>5</sup> = 486).",
        "S = a<sub>1</sub>(q<sup>n</sup> − 1)/(q − 1) = 2(729 − 1)/2 = <b>728</b>."
