      ],
      "vastaus": {
        "tyyppi": "numerot",
        "oikeat": [
          4,
          6,
          0
        ],
        "toleranssi": 0.01,
        "jarjestys": true,
        "esimerkki": "1; 2; 3"
      },
      "ratkaisu": [
        "Sijoitetaan: (1 + t) + 2t + (3 − t) = 10 ⇒ 4 + 2t = 10 ⇒ t = 3.",
        "Piste (4, 6, 0)."
      ]
    },
    {
      "id": "maa10-harj-10",
      "numero": "10",
      "aihe": "Kohtisuorat vektorit",
      "pisteet": 6,
      "muistilista": "MAA10",
      "teksti": [
        "Millä t:n arvolla vektorit <b>i</b> + t<b>j</b> + 2<b>k</b> ja 3<b>i</b> + <b>j</b> − 2<b>k</b> ovat kohtisuorassa?"
