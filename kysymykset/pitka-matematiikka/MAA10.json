      ]
    },
    {
      "id": "maa10-harj-08",
      "numero": "8",
      "aihe": "Pisteen etäisyys tasosta",
      "pisteet": 6,
      "muistilista": "MAA10",
      "teksti": [
        "<b>Laske</b> pisteen (1, 2, 2) etäisyys tasosta 2x + y + 2z − 3 = 0."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 1.666667,
        "toleranssi": 0.005,
        "desimaalit": 2,
        "esimerkki": "1,00"
      },
      "ratkaisu": [
        "d = |2 + 2 + 4 − 3| / √(4 + 1 + 4) = 5 / 3.",
        "d ≈ <b>1,67</b>."
      ]
    },
    {
      "id": "maa10-harj-09",
      "numero": "9",
      "aihe": "Suoran ja tason leikkauspiste",
      "pisteet": 12,
      "muistilista": "MAA10",
      "teksti": [
        "Suora x = 1 + t, y = 2t, z = 3 − t leikkaa tason x + y + z = 10.",
