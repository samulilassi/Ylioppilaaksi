      "vastaus": {
        "tyyppi": "numero",
        "oikea": 60,
        "toleranssi": 0.1,
        "yksikko": "°",
        "esimerkki": "45"
      },
      "ratkaisu": [
        "cos α = 1 / (√2 · √2) = ½.",
