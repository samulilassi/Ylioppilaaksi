      ]
    },
    {
      "id": "maa10-harj-06",
      "numero": "6",
      "aihe": "Suoran parametriesitys",
      "pisteet": 6,
      "muistilista": "MAA10",
      "teksti": [
        "Suora kulkee pisteen (1, 2, 3) kautta suuntavektorina 2<b>i</b> − <b>j</b> + <b>k</b>.",
