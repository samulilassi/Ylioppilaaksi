      ]
    },
    {
      "id": "maa10-harj-07",
      "numero": "7",
      "aihe": "Tason etäisyys origosta",
      "pisteet": 12,
      "muistilista": "MAA10",
      "teksti": [
        "Taso kulkee pisteiden (1, 0, 0), (0, 2, 0) ja (0, 0, 3) kautta. <b>Laske tason etäisyys origosta</b> (kolmen desimaalin tarkkuudella)."
