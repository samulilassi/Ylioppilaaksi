      "ratkaisu": [
        "4 − 10 + 18 = <b>12</b>."
      ]
    },
    {
      "id": "maa10-harj-04",
      "numero": "4",
      "aihe": "Ristitulo ja suunnikkaan ala",
      "pisteet": 6,
      "muistilista": "MAA10",
      "teksti": [
        "<b>Laske</b> vektorien <b>a</b> = <b>i</b> + 2<b>j</b> ja <b>b</b> = 3<b>i</b> + <b>j</b> virittämän suunnikkaan pinta-ala."
      ],
      "vastaus": {
        "tyyppi": "numero",
        "oikea": 5,
        "toleranssi": 0.01,
        "esimerkki": "7"
      },
      "ratkaisu": [
        "a × b = (1·1 − 2·3)k = −5k.",
        "Ala = |a × b| = <b>5</b>."
      ]
    },
    {
      "id": "maa10-harj-05",
      "numero": "5",
      "aihe": "Vektorien välinen kulma",
      "pisteet": 6,
      "muistilista": "MAA10",
      "teksti": [
        "<b>Laske</b> vektorien <b>i</b> + <b>j</b> ja <b>i</b> + <b>k</b> välinen kulma."
