    {
      "id": "maa10-harj-03",
      "numero": "3",
      "aihe": "Pistetulo",
      "pisteet": 6,
      "muistilista": "MAA10",
      "teksti": [
        "<b>Laske</b> vektorien <b>i</b> + 2<b>j</b> + 3<b>k</b> ja 4<b>i</b> − 5<b>j</b> + 6<b>k</b> pistetulo."
