      "vastaus": {
        "tyyppi": "numero",
        "oikea": 0.857143,
        "toleranssi": 0.002,
        "desimaalit": 3,
        "esimerkki": "0,5"
      },
      "ratkaisu": [
        "Tason yhtälö x/1 + y/2 + z/3 = 1 eli 6x + 3y + 2z − 6 = 0.",
