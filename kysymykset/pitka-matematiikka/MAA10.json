      "vastaus": {
        "tyyppi": "numero",
        "oikea": 1,
        "toleranssi": 0.01,
        "esimerkki": "2"
      },
      "ratkaisu": [
        "Pistetulo 3 + t − 4 = 0.",
        "t = <b>1</b>."
      ]
    },
    {
      "id": "maa10-harj-11",
      "numero": "11",
      "aihe": "Tason normaalivektori",
      "pisteet": 6,
      "muistilista": "MAA10",
      "teksti": [
        "<b>Mikä seuraavista on tason 2x − y + 3z = 7 normaalivektori?</b>"
